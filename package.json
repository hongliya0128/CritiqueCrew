    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "preact": "^10.29.7"
  }
}
